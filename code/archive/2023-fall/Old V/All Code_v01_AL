ix, cleans and checks data as well (nonzero values)\n","def df_to_matrix(dfa):\n","  raw_matrixa = dfa.to_numpy()\n","  matrixa = [list(dfa.columns)]\n","\n","  for row in raw_matrixa:\n","\n","    stripped=np.char.strip(np.array(row[1::]).astype(str),chars='_')\n","    if np.min(stripped.astype(float)) > 0:\n","      matrixa.append(list(row))\n","\n","  return matrixa"]},{"cell_type":"code","execution_count":9,"metadata":{"id":"Tu_02RmJqIdG","executionInfo":{"status":"ok","timestamp":1703301282347,"user_tz":300,"elapsed":183,"user":{"displayName":"Allison Lin","userId":"16247319298095704339"}}},"outputs":[],"source":["## UPDATED - MD: needed to deal with non-numeric str and NAN for df7 (GDP4 file)\n","# equivalent to df_to_matrix(dfa)\n","\n","def df7_to_matrix(df7_cl):\n","    temp = df7_cl.dropna()\n","\n","    # Create an empty dictionary\n","    gdp_range_dict = {}\n","\n","    # Iterate over the rows of the data frame\n","    for index, row in temp.iterrows():\n","      # Get the country name\n","      country = row['Country Name']\n","      year_value_list = []\n","      for year in range(begin_year, end_year+1):\n","\n","        value_year = row[str(year)]\n","        if value_year.isnumeric():\n","          value_year = float(value_year)\n","        else:\n","          value_year = None\n","        year_value_list.append((year, value_year))\n","      gdp_range_dict[country] = year_value_list\n","\n","    # Iterate over the rows of the data frame\n","\n","    # The output dictionary should now have an entry for each country in the data frame\n","    return gdp_range_dict"]},{"cell_type":"code","execution_count":10,"metadata":{"id":"y0s59vnvwfRq","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1703301285033,"user_tz":300,"elapsed":596,"user":{"displayName":"Allison Lin","userId":"16247319298095704339"}},"outputId":"6603da20-75c9-409a-9db2-a1785d54c4e6"},"outputs":[{"output_type":"stream","name":"stdout","text":["{'Afg